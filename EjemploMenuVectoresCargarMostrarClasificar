}

void cargar(int vec[], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << "Vector[" << i << "]= ";
        cin >> vec[i];
    }
}

void mostrar(int vec[], int n)
{
    for (int i = 0; i < n; i++)
        cout << "Vector[" << i << "]= " << vec[i] << endl;
}

void burbuja(int vec[], int m)
{
    int aux;
    for (int i = 0; i < m - 1; i++)
    {
        for (int j = i + 1; j < m; j++)
            if (vec[i] > vec[j])
            {
                aux = vec[j];
                vec[j] = vec[i];
                vec[i] = aux;
            }
    }
}

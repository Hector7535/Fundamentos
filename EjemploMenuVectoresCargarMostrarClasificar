#include <iostream>
#define MAX 100
void menu();
void cargar(int vec[], int n);
void mostrar(int vec[], int n);
void unir(int v1[], int n, int v2[], int m, int vec[], int& tam);
void burbuja(int vec[], int m);

using namespace std;
int main()
{
    int opcion, tam, n, m, A[MAX], B[MAX], C[MAX];;
    double b[] = { 3.5, 6.3, 4.5, 7.5, 5.4 };
    do {
        menu();
        cin >> opcion;
        switch (opcion)
        {
        case 1:
            do {
                cout << "Ingresar el tamaño del primer vector:";
                cin >> n;
            } while ((n <= 0) || (n > MAX));
            cargar(A, n);
            do {
                cout << "Ingresar el tamaño del segundo vector:";
                cin >> m;
            } while ((m <= 0) || (m > MAX));
            cargar(B, m);

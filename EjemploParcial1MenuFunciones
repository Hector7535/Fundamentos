void primerapregunta(int edad, int nota)
{
    if (edad >= 18) {
        if (nota >= 70)
            cout << "APROBADO-MAYOR DE EDAD\n";
        else
            cout << "REPROBADO - MAYOR DE EDAD\n";
    }
    else {
        if (nota >= 60)
            cout << "APROBADO - MENOR DE EDAD\n";
        else
            cout << "REPROBADO - MENOR DE EDAD\n";
    }
}
int precio(int peso, int &costo)
{
    if (peso <= 2)
        costo=15;
    else 
    if (peso > 2 && peso <= 5)
        costo = 25;
    else 
    if (peso > 5 && peso <= 10)
        costo = 40;
    else
        costo=60;
    return costo;
}
float totalapagar(int cantidad, float precio, float &total)
{
    if (cantidad >= 3)
        total = cantidad * precio *  0.8;
    else
        total = cantidad * precio *  0.9;
    return total;
}

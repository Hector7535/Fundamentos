float discriminante(float a, float b, float c)
{
    float dis;
    dis=(b*b)-(4*a*c);
    return dis;
    
}
float real(float a, float b, float c, float &x1, float &x2, float &dis)
{
    x1=(-b+sqrt(discriminante(a, b, c)))/(2*a);
    x2=(-b-sqrt(discriminante (a, b, c)))/(2*a);
    return x1, x2;
}
float unica(float a, float b)
{
    return -b/(2*a);
}
float imaginaria(float a, float b, float c, float &R, float &I, float &dis)
{
    R=-b/(2*a);
    I=sqrt(-1*(discriminante (a,b,c)));
    return R, I;
}

float unica0(float b, float c)
{
    return -c/b;
}

#include <iostream>
#include <math.h>

using namespace std;

int main()
{
    float a,b,c,s,Area;
    cout<<"Ingresar lado 1: ";
    cin>>a;
    cout<<"Ingresar lado 2: ";
    cin>>b;
    cout<<"Ingresar lado 3: ";
    cin>>c;
    s=(a+b+c)/2;
    Area=sqrt(s*(s-a)*(s-b)*(s-c));
    cout<<"El Area es: "<<Area;
    
    return 0;
}
